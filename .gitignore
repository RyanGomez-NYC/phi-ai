# Secrets and deployment-specific configuration. docs/RELEASE_CHECKLIST.md
# §1 relies on every one of these patterns being here; keep them in sync.
.env
# Every local env variant: .env.azure / .env.aws (per-cloud output_fragment
# captures) and .env.backup-* (taken before any merge). These hold real
# secrets - session secret, Epic client id. The two committed templates below
# are re-included deliberately.
.env.*
!.env.example
!.env.defaults
*.pem
*.key
terraform.tfvars
backend.hcl
*.tfplan
*.tfstate
*.tfstate.*

# Deployer-owned config files (templates are committed as *.example.*)
config/retention_ruleset.yaml
config/smart_issuers.yaml
config/assistant_probes.yaml

# Terraform working directories (lock files stay tracked)
.terraform/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Local run output
restore-output/

# macOS
.DS_Store

# Generated synthetic corpora (reproducible from generator+version+seed; see docs/TESTDATA.md)
testdata/
.cache/

# Terraform saved plans: embed variable values (including generated
# secrets) - never commit.
tfplan*
**/tfplan*
tfboot
# Generated imaging frames. Ignored except for the deny rule, which is
# protection and belongs in the repo - see www-demo/var/ below.
www-demo/public/cache/*
!www-demo/public/cache/.htaccess
# Runtime state - caches, generated frames, uploaded audio. Ignored except
# for the deny rule itself, which is protection and belongs in the repo.
www-demo/var/*
!www-demo/var/.htaccess
www-analytics/config.local.php

# Every config variant, not just config.php. config.new.php carried a live DB
# password and an API key and was one `git add -A` away from the repo on
# 2026-09-06. The example file is the only one that belongs in history.
www-demo/app/config*.php
!www-demo/app/config.example.php

# Components screen (core/components): build products written by
# scripts/components.py, the gate record, a deployment's release drop,
# and the engine's copies of operator files. The signing PRIVATE key is a
# *.key above. The verification key config/release_signing.pub is placed on
# each host by the operator and is never committed either: no keys in a repository.
BUILD.json
MANIFEST.sha256
MANIFEST.sha256.sig
components.manifest.json
.gates/
releases/
config/*.previous
config/release_signing.pub
