# PHI AI Platform - deployment configuration template
#
# Copy this file to .env and fill it in (or let install/installer_chatbot.py
# write .env for you). Every variable this project reads is named
# PHI_AI_<SUFFIX> and is read through core/config/settings.py's env_var() -
# that module's docstring explains why there is exactly one spelling and one
# precedence rule.
#
# .env is gitignored and must never be committed: it names your buckets,
# keys, and EMR registration. Key MATERIAL never goes in here at all -
# private keys and API keys are referenced by file path and mounted
# read-only into the container (see docker-compose.yml), because PEM or
# key text in an env var reaches process listings and log capture in ways
# a mounted file does not.
#
# Lines starting with a required variable are uncommented with a
# placeholder you must replace. Optional settings are commented out at
# their defaults - uncomment only what you are deliberately changing.
# The authoritative documentation for each setting is the module named
# next to its section header.

# ---------------------------------------------------------------------------
# Cloud platform (core/config/settings.py, core/storage/factory.py)
# ---------------------------------------------------------------------------

# Which cloud this deployment runs in: aws | gcp | azure. Decides the
# storage, KMS and audit-sink implementations behind the common
# abstraction. Required.
PHI_AI_CLOUD_PROVIDER=aws

# Deployment shape: small | large. Decides the storage layout and index
# partitioning, and CANNOT be changed on a populated object store - see
# docs/SCALING.md before choosing anything but the default.
#PHI_AI_PROFILE=small

# FHIR namespace minted into stored resources and delivered records
# (core/config/canonical.py). Set it to a domain your organisation
# controls BEFORE ingesting - changing it later does not rewrite
# resources already written. See docs/RELEASE_CHECKLIST.md §2.
#PHI_AI_CANONICAL_BASE=https://phi-ai.example.org/fhir

# ---------------------------------------------------------------------------
# PHI object storage - the unconditional system of record
# ---------------------------------------------------------------------------
# All five values come from `terraform output -raw env_fragment` after
# applying the stack in deploy/<cloud>/ - see your cloud's setup runbook.
# The audit bucket and key are deliberately separate from the object
# store's, so append-only audit access can be granted without also
# granting decrypt access to PHI (see deploy/aws/iam.tf).

PHI_AI_STORAGE_BUCKET=your-phi-store-bucket
PHI_AI_STORAGE_REGION=us-east-1
PHI_AI_KMS_KEY_ID=your-kms-key-id-or-arn
PHI_AI_AUDIT_BUCKET=your-audit-bucket
PHI_AI_AUDIT_KMS_KEY_ID=your-audit-kms-key-id-or-arn

# Psychotherapy notes (optional) - a genuinely separate storage boundary
# with its own bucket and key, never a flag within the general store.
# Read runbooks/RUNBOOK_PSYCHOTHERAPY_NOTES.md before setting these; the
# psychotherapy write path fails loudly rather than falling back to the
# general store when they are needed but unset.
#PHI_AI_PSYCHOTHERAPY_STORAGE_BUCKET=
#PHI_AI_PSYCHOTHERAPY_KMS_KEY_ID=

# Provider-specific extras. GCP deployments set gcp_project; Azure
# deployments set both URLs (from the deploy/azure outputs).
#PHI_AI_GCP_PROJECT=
#PHI_AI_AZURE_ACCOUNT_URL=https://<account>.blob.core.windows.net
#PHI_AI_AZURE_VAULT_URL=https://<vault>.vault.azure.net

# ---------------------------------------------------------------------------
# Retention (core/config/retention_rules.py, docs/COMPLIANCE.md)
# ---------------------------------------------------------------------------
# Retention here is RECORDED, not enforced - no storage-level WORM exists
# on any cloud; read docs/COMPLIANCE.md → "Retention and integrity".
#
# Preferred: a HIM-owned ruleset file with a citation, reviewer and
# review date per rule. Copy config/retention_ruleset.example.yaml to
# config/retention_ruleset.yaml, fill it in with your organisation's own
# reviewed figures, and check it with
# `python -m core.config.retention_rules_check`. When set, this takes
# precedence and the flat variables below are ignored entirely.
#PHI_AI_RETENTION_RULESET_PATH=config/retention_ruleset.yaml

# Fallback: a flat deployment-wide period in years (default 10), with
# optional per-resource-type overrides as a JSON object.
#PHI_AI_RETENTION_YEARS=10
#PHI_AI_RETENTION_YEARS_OVERRIDES={"DocumentReference": 15, "Immunization": 30}

# ---------------------------------------------------------------------------
# Source EMR connection (core/fhir/, docs/EMR_CONNECTORS.md)
# ---------------------------------------------------------------------------

# Which vendor profile to use: epic | cerner | athenahealth |
# eclinicalworks | meditech | nextgen (core/fhir/emr_profiles.py).
# Validated at startup so a typo fails next to its cause.
#PHI_AI_EMR_VENDOR=epic

# From your EMR registration - see docs/EMR_CONNECTORS.md for each
# vendor's registration walk-through. Required.
PHI_AI_FHIR_BASE_URL=https://fhir.example.org/api/FHIR/R4
PHI_AI_FHIR_TOKEN_URL=https://fhir.example.org/oauth2/token
PHI_AI_FHIR_CLIENT_ID=your-client-id

# Path to the RS384 private key for SMART Backend Services vendors
# (generate one with scripts/generate_epic_keypair.sh). Required even for
# client-secret vendors - the file must exist; see settings.py. Use an
# absolute path: docker-compose.yml mounts it read-only at the SAME path
# inside the container, so one value works on the host and in compose.
PHI_AI_FHIR_PRIVATE_KEY_PATH=/absolute/path/to/epic_private_key.pem

# JWT kid header, when your registration pinned one (JWKS-hosted keys
# usually do - see deploy/aws/README_EPIC_JWKS.md).
#PHI_AI_FHIR_JWT_KID=

# athenahealth only: its auth model is a client secret, not a JWT
# assertion. Required at startup when PHI_AI_EMR_VENDOR=athenahealth;
# leave unset for every other vendor (Epic never accepts one).
#PHI_AI_FHIR_CLIENT_SECRET=

# Per-resource-type search scheduler (core/fhir/scheduler.py) interval.
#PHI_AI_INTERVAL_SECONDS=3600

# Bulk Data Export (core/fhir/bulk_scheduler.py). The Group FHIR ID is
# not discoverable through any API - it comes from the vendor or the
# organisation; the bulk scheduler fails with a clear error when it is
# needed but missing. Epic rate-limits $export to once per 24h per
# group+client, hence the daily default interval.
#PHI_AI_FHIR_GROUP_ID=
#PHI_AI_BULK_INTERVAL_SECONDS=86400
#PHI_AI_BULK_POLL_INTERVAL_SECONDS=600
#PHI_AI_BULK_MAX_WAIT_SECONDS=14400

# ---------------------------------------------------------------------------
# Postgres index and derived layers (optional - core/db/connection.py)
# ---------------------------------------------------------------------------
# The object store stays the system of record whether or not any of this
# is configured; unset means indexing is simply skipped. No password
# variables exist anywhere: every connection authenticates with a
# short-lived IAM/Entra credential generated at connect time.
#
# AWS and Azure connect over db_host/db_port. GCP leaves those unset and
# uses the Cloud SQL instance connection name instead.
#PHI_AI_DB_HOST=
#PHI_AI_DB_PORT=5432
#PHI_AI_DB_NAME=
#PHI_AI_GCP_CLOUD_SQL_INSTANCE_CONNECTION_NAME=project:region:instance

# Role usernames, deliberately separate because the bootstrap SQL grants
# them different privileges (core/db/bootstrap_<cloud>.sql). Set only the
# ones your deployment provisioned.
#PHI_AI_DB_INGEST_USERNAME=
#PHI_AI_DB_READER_USERNAME=

# OMOP CDM analytics layer (opt-in; IDENTIFIED PHI - read
# core/db/omop_schema.sql's header and runbooks/RUNBOOK_OMOP_SETUP.md
# first). ETL writes as omop_etl; analytics reads through the read-only
# analyst role; population analytics needs both.
#PHI_AI_OMOP_ETL_USERNAME=
#PHI_AI_OMOP_ANALYST_USERNAME=

# Name search (opt-in; the ONE place a patient's name lives outside an
# encrypted object - read core/db/identity_schema.sql's header first).
# Deliberately not implied by analytics: counting cohorts and resolving
# them to people are different privileges.
#PHI_AI_IDENTITY_READER_USERNAME=

# Disposition role (core/fhir/purge.py) - deletes index and OMOP rows in
# the same disposal operation as the storage delete. Unset means
# storage-only disposal.
#PHI_AI_DISPOSITION_DB_USERNAME=

# DICOM imaging index (opt-in; IDENTIFYING PHI in queryable columns -
# read runbooks/RUNBOOK_DICOM_IMAGING.md's warning first). Unset means
# the DICOMweb API is never mounted.
#PHI_AI_IMAGING_DB_USERNAME=

# Clinical retrieval index (opt-in) - the assistant's cross-record text
# search; CLINICAL PROSE IN THE CLEAR, the broadest derived store here.
# Read core/db/retrieval_schema.sql's header before enabling. ETL writes
# it (python -m core.db.retrieval_etl); the search role is what the
# researcher role's assistant tool reads through; the psych role covers
# the SEPARATE psychotherapy table only (see the assistant section
# below - it needs its own acknowledgement too).
#PHI_AI_RETRIEVAL_ETL_USERNAME=
#PHI_AI_RETRIEVAL_SEARCH_USERNAME=
#PHI_AI_RETRIEVAL_PSYCH_USERNAME=

# Assistant telemetry / ops page (opt-in) - metrics only, never content
# (core/db/telemetry_schema.sql). Feeds /assistant/ops and the drift
# suite's recorded results.
#PHI_AI_ASSISTANT_OPS_USERNAME=

# ---------------------------------------------------------------------------
# Web interface (core/web/ - runbooks/RUNBOOK_WEB_UI.md)
# ---------------------------------------------------------------------------

# Bind address for python -m core.web. The default binds loopback only;
# put an authenticating reverse proxy in front before widening it.
#PHI_AI_WEB_HOST=127.0.0.1
#PHI_AI_WEB_PORT=8080

# HOW IDENTITY REACHES THE APP - exactly one of the three modes below.
# There is deliberately no default: core/web/auth.py refuses to start
# until you have said which deployment this is.
#
# 1) An authenticating reverse proxy (oauth2-proxy, OIDC ALB, App Service
#    auth) in front of the app, forwarding identity headers. Set true
#    ONLY when the app is unreachable except through that proxy.
#PHI_AI_WEB_TRUST_PROXY_AUTH=true
#PHI_AI_WEB_USER_HEADER=X-Auth-Request-User
#PHI_AI_WEB_EMAIL_HEADER=X-Auth-Request-Email
#PHI_AI_WEB_GROUPS_HEADER=X-Auth-Request-Groups
#
# 2) Local accounts managed inside the app (runbooks/RUNBOOK_LOCAL_USERS.md).
#    The deployment key peppers password hashes and encrypts TOTP secrets -
#    32 bytes, base64 or hex; generate with:
#    python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
#PHI_AI_WEB_LOCAL_ACCOUNTS=true
#PHI_AI_WEB_LOCAL_AUTH_KEY=
#PHI_AI_WEB_LOCAL_AUTH_MFA=required
#PHI_AI_WEB_LOCAL_AUTH_ISSUER=PHI AI Platform
#PHI_AI_WEB_LOCAL_AUTH_BLOCKLIST=
#PHI_AI_WEB_LOCAL_AUTH_SESSION_MINUTES=30
#PHI_AI_WEB_LOCAL_AUTH_PASSWORD_MAX_AGE_DAYS=
#
# 3) Local development against SYNTHETIC data only - fabricates an
#    identity with no authentication at all, and logs loudly about it.
#PHI_AI_WEB_DEV_IDENTITY=dev:admin

# Session cookie signing secret. Generated ephemerally in development
# when unset (sessions do not survive a restart); set a stable value in
# any real deployment.
#PHI_AI_WEB_SESSION_SECRET=

# Absolute session lifetime and idle timeout, minutes. The idle default
# follows the common healthcare workstation guidance.
#PHI_AI_WEB_SESSION_MINUTES=30
#PHI_AI_WEB_IDLE_MINUTES=15

# SMART on FHIR EHR launch (runbooks/RUNBOOK_SMART_LAUNCH.md). The
# issuer allowlist lives in config/smart_issuers.yaml (copy
# config/smart_issuers.example.yaml); the redirect URI is the one you
# registered with each EMR.
#PHI_AI_SMART_ISSUERS_PATH=config/smart_issuers.yaml
#PHI_AI_WEB_SMART_REDIRECT_URI=https://your-deployment.example.org/smart/callback

# Embedded OHIF viewer origin (runbooks/RUNBOOK_DICOM_IMAGING.md) - a
# SEPARATE origin, so script-src 'none' stays intact on PHI pages.
#PHI_AI_IMAGING_VIEWER_URL=http://127.0.0.1:3000
#PHI_AI_IMAGING_MAX_STUDY_METADATA=500

# ---------------------------------------------------------------------------
# Scheduled verification (python -m core.verify - runbooks/RUNBOOK_VERIFICATION.md)
# ---------------------------------------------------------------------------
#PHI_AI_VERIFY_INTERVAL_SECONDS=86400
#PHI_AI_VERIFY_DEEP_EVERY=7
#PHI_AI_VERIFY_EXPORT_DIR=
#PHI_AI_VERIFY_SKIP_SOURCE=false

# ---------------------------------------------------------------------------
# Records delivery to a live EMR (python -m core.fhir.delivery)
# ---------------------------------------------------------------------------
# The DESTINATION EMR's credentials - a separate registration from the
# source connection above. Either a pre-issued access token, or a
# client_id + token_url with a client secret or private key.
#PHI_AI_DELIVERY_ACCESS_TOKEN=
#PHI_AI_DELIVERY_CLIENT_ID=
#PHI_AI_DELIVERY_TOKEN_URL=
#PHI_AI_DELIVERY_CLIENT_SECRET=
#PHI_AI_DELIVERY_PRIVATE_KEY_PATH=

# Additional base URLs that identify the SOURCE EMR, beyond
# PHI_AI_FHIR_BASE_URL - delivery back into the system of origin is
# refused (comma-separated).
#PHI_AI_SOURCE_EMR_URLS=

# ---------------------------------------------------------------------------
# AI assistant (optional, OFF by default - runbooks/RUNBOOK_AI_ASSISTANT.md)
# ---------------------------------------------------------------------------
# The one component that sends anything outside the deployment. Read the
# runbook before enabling; both acknowledgement flags exist so that
# enabling it is a decision, not a side effect.
#PHI_AI_ASSISTANT_ENABLED=true
#PHI_AI_ASSISTANT_EGRESS_ACKNOWLEDGED=true

# Provider is a compliance decision, not a preference: bedrock (AWS) and
# vertex (GCP) run Claude inside your own cloud account under the BAA you
# already rely on; anthropic calls the Anthropic API directly (the only
# option on Azure) and needs its own BAA conversation.
#PHI_AI_ASSISTANT_PROVIDER=anthropic
#PHI_AI_ASSISTANT_MODEL=
#PHI_AI_ASSISTANT_EFFORT=

# anthropic provider only: path to a file holding the API key, mounted
# read-only like the Epic private key. (The SDK's own ANTHROPIC_API_KEY
# env var works as a fallback, with a logged warning - prefer the file.)
#PHI_AI_ASSISTANT_API_KEY_PATH=/absolute/path/to/anthropic_api_key

# bedrock / vertex placement, when different from the storage settings.
#PHI_AI_ASSISTANT_AWS_REGION=
#PHI_AI_ASSISTANT_GCP_PROJECT=
#PHI_AI_ASSISTANT_GCP_REGION=global

# Whether the assistant may read clinical content: none (default) |
# in_context (the record the user has open) | lookup (anything the
# user's role permits). Any tier above none requires its own
# acknowledgement that a BAA covers the configured provider.
# Psychotherapy notes are NOT included at any tier - see below.
#PHI_AI_ASSISTANT_PHI_ACCESS=none
#PHI_AI_ASSISTANT_PHI_ACKNOWLEDGED=true

# Psychotherapy notes (45 CFR 164.508(a)(2)) - OFF at every tier unless
# both flags are set. Requires the lookup tier, the psych retrieval
# role above, and the asking user's own `psychotherapy` application
# role; every search and read is audited as a disclosure. Read
# runbooks/RUNBOOK_AI_ASSISTANT.md -> "Psychotherapy notes" first.
#PHI_AI_ASSISTANT_PSYCHOTHERAPY_ACCESS=true
#PHI_AI_ASSISTANT_PSYCHOTHERAPY_ACKNOWLEDGED=true

# Grounded per-patient retrieval (docs/SPEC.md §5.1). The
# grounded_patient_evidence tool exists ONLY when this points at your
# curated copy of config/sensitive_value_sets.example.yaml - grounded
# retrieval without a sensitive-category exclusion vocabulary would
# fail open, so absent this setting the tool is simply not built.
# Curation is operator work: see the file's own header and
# runbooks/RUNBOOK_MODEL_GOVERNANCE.md -> "Segmentation".
#PHI_AI_SENSITIVE_VALUE_SETS=/etc/phi-ai/sensitive_value_sets.yaml

# Tool-loop ceiling per question, and the docs root override for
# containers that mount documentation somewhere other than the repo.
#PHI_AI_ASSISTANT_MAX_TOOL_ITERATIONS=6
#PHI_AI_ASSISTANT_DOCS_ROOT=
