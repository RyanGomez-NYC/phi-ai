# PHI AI Platform - committed fallback for docker-compose.yml's env_file.
#
# WHY THIS FILE EXISTS. Every service in docker-compose.yml declares
# `env_file: .env`, and .env is gitignored - it names a deployment's
# buckets, keys and EMR registration, so it can never be committed. That
# left a fresh clone unable to run `docker compose config` at all: the
# file it is told to read does not exist yet, and Compose treats a missing
# env_file as a hard error. `python -m pytest tests/ -q`, which README.md
# tells a new contributor to run first, failed on that one test for the
# same reason. The promise was "the full suite runs without any cloud";
# the suite was red until you had provisioned one.
#
# So compose reads this file FIRST and .env SECOND. Compose applies
# env_file entries in order and later entries win, so every value here is
# a default that a real .env overrides silently. Nothing is required of a
# clone beyond `git clone`.
#
# WHAT BELONGS HERE: non-secret defaults, and values whose absence would
# break the RENDER rather than the run. Nothing else.
#
# WHAT NEVER BELONGS HERE: bucket names, account ids, hostnames, client
# ids, key material of any kind, or a path to key material on a real host.
# This file is committed to a public repository. A key is placed on a host
# and named by .env, never carried in the tree - see .gitignore.
#
# EVERY VALUE HERE IS DELIBERATELY EMPTY OR A LOCAL DEVELOPMENT DEFAULT.
# An empty value is not a working configuration and is not meant to be
# one: core/config/settings.py's env_var() treats empty as unset, so each
# subsystem raises its own named error naming the variable to set. That
# is the intended experience of running this without a .env - a clear
# message about what is missing, not a KeyError or a silent default that
# writes PHI somewhere nobody chose.

# ---------------------------------------------------------------------------
# Cloud platform - core/config/settings.py, core/storage/factory.py
# ---------------------------------------------------------------------------
# Empty, not "aws": defaulting a cloud is how a deployment ends up writing
# to whichever provider the sample file happened to name.
PHI_AI_CLOUD_PROVIDER=
PHI_AI_STORAGE_BUCKET=
PHI_AI_STORAGE_REGION=
PHI_AI_KMS_KEY_ID=
PHI_AI_AUDIT_BUCKET=
PHI_AI_AUDIT_KMS_KEY_ID=
PHI_AI_PSYCHOTHERAPY_STORAGE_BUCKET=
PHI_AI_PSYCHOTHERAPY_KMS_KEY_ID=

# ---------------------------------------------------------------------------
# Postgres index - core/db/connection.py
# ---------------------------------------------------------------------------
PHI_AI_DB_HOST=
PHI_AI_DB_PORT=5432
PHI_AI_DB_NAME=
PHI_AI_DB_INGEST_USERNAME=
PHI_AI_DB_READER_USERNAME=
PHI_AI_DISPOSITION_DB_USERNAME=
PHI_AI_OMOP_ETL_USERNAME=
PHI_AI_OMOP_ANALYST_USERNAME=

# ---------------------------------------------------------------------------
# EMR connection - core/fhir/client.py, core/fhir/emr_profiles.py
# ---------------------------------------------------------------------------
PHI_AI_EMR_VENDOR=
PHI_AI_FHIR_BASE_URL=
PHI_AI_FHIR_TOKEN_URL=
PHI_AI_FHIR_CLIENT_ID=
# A PATH, never key text. Empty here; docker-compose.yml mounts whatever
# a real .env names, read-only. See the file header on why no default.
PHI_AI_FHIR_PRIVATE_KEY_PATH=

# ---------------------------------------------------------------------------
# Web interface - core/web/app.py
# ---------------------------------------------------------------------------
PHI_AI_WEB_HOST=0.0.0.0
PHI_AI_WEB_PORT=8080
# Empty on purpose. core/web/app.py generates an ephemeral secret and logs
# a warning naming this variable; a committed default would be a published
# session-signing key, which is worse than no key at all.
PHI_AI_WEB_SESSION_SECRET=
PHI_AI_WEB_SESSION_MINUTES=30
PHI_AI_WEB_IDLE_MINUTES=15
# Secure cookies ON by default. The local-http escape hatch is a thing a
# developer turns on deliberately in their own .env, never a default that
# ships.
PHI_AI_WEB_INSECURE_COOKIES=
PHI_AI_WEB_TRUST_PROXY_AUTH=
PHI_AI_WEB_DEV_IDENTITY=
PHI_AI_WEB_DEV_PERSONAS=

# ---------------------------------------------------------------------------
# Assistant - core/assistant/config.py
# ---------------------------------------------------------------------------
# Off unless a deployment turns it on: the assistant is the one subsystem
# that sends anything anywhere, and its default is not to exist.
PHI_AI_ASSISTANT_ENABLED=
PHI_AI_ASSISTANT_PROVIDER=
PHI_AI_ASSISTANT_MODEL=
# A PATH, never the key. Same rule as the FHIR key above.
PHI_AI_ASSISTANT_API_KEY_PATH=

# ---------------------------------------------------------------------------
# Retention - core/config/retention_rules.py
# ---------------------------------------------------------------------------
PHI_AI_RETENTION_YEARS=

# Made by Ryan Gomez & Co. Inc.
